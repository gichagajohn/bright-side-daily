name: Bright Side Daily - Instagram Analytics & Replies

on:
  schedule:
    # Insights every 6 hours, comment replies every 2 hours during the day.
    - cron: "0 */6 * * *"
    - cron: "0 5-19/2 * * *"

  workflow_dispatch:
    inputs:
      task:
        description: "what to run"
        required: false
        default: "all"
        type: choice
        options:
          - all
          - insights
          - replies
          - schedule

permissions:
  contents: write

concurrency:
  group: bright-side-analytics
  cancel-in-progress: false

jobs:
  analytics:
    name: Collect insights and reply to comments
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Collect insights
        env:
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
          DRY_RUN: "false"
        run: |
          if [ "${{ github.event.inputs.task || 'all' }}" = "replies" ]; then
            echo "Skipping insights."
          else
            python src/agents/instagram_insights.py || echo "Insights skipped."
          fi

      - name: Optimise schedule
        env:
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
        run: |
          if [ "${{ github.event.inputs.task || 'all' }}" = "replies" ]; then
            echo "Skipping schedule analysis."
          else
            python src/agents/schedule_optimizer.py || echo "Schedule analysis skipped."
          fi

      - name: Reply to comments
        env:
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
          COMMENT_MAX_REPLIES: "25"
          DRY_RUN: "false"
        run: |
          if [ "${{ github.event.inputs.task || 'all' }}" = "insights" ]; then
            echo "Skipping replies."
          else
            python src/agents/comment_agent.py || echo "Replies skipped."
          fi

      - name: Commit metrics
        if: always()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add data/metrics/ data/state/ || true

          if ! git diff --staged --quiet; then
            git commit -m "chore: instagram metrics and replies [skip ci]"
            git push
          else
            echo "No metric changes."
          fi
